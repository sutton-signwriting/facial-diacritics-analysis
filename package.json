{
  "name": "facial-diacritics-analysis",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "scripts": {
    "process": ".venv/bin/python scripts/process_sources.py && .venv/bin/python scripts/process_eye_gaze.py",
    "process:eye-gaze": ".venv/bin/python scripts/process_eye_gaze.py",
    "build": ".venv/bin/python scripts/build_site.py",
    "test": ".venv/bin/python -m unittest discover -s tests -v",
    "preview": ".venv/bin/python -m http.server 9123 --bind 127.0.0.1 --directory dist",
    "test:browser": "node scripts/check_browser.mjs",
    "test:links": "node scripts/check_links.mjs",
    "test:eye-gaze": "node scripts/check_eye_gaze.mjs",
    "test:examples": "node scripts/check_examples.mjs"
  },
  "dependencies": {
    "@sutton-signwriting/font-ttf": "1.6.0"
  },
  "devDependencies": {
    "playwright": "1.55.0"
  }
}
